<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Models="clr-namespace:FleetManager.Models"
             xmlns:protocol="clr-namespace:Tmds.DBus.Protocol;assembly=Tmds.DBus.Protocol"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:ViewModels="clr-namespace:FleetManager.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FleetManager.Views.FleetList"
             x:DataType="ViewModels:VehicleItemViewModel"
             >
    
    <Border Padding="10"
            Margin="5"
            BorderThickness="1"
            CornerRadius="6">

        <Grid ColumnDefinitions="50,150,100,*,120"
              VerticalAlignment="Center"
              ColumnSpacing="5"
              >
            
            <TextBlock Grid.Column="0"
                       Text="{Binding VehicleId}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            
            <TextBlock Grid.Column="1"
                       Text="{Binding VehicleName}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"/>
            
            <TextBlock Grid.Column="2"
                       Text="{Binding VehicleTag}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            <Grid Grid.Column="3" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0"
                        Content="Paliwo++"
                        Command="{Binding AddFuelCommand}"
                        Background="#351C15"
                        Foreground="#FFB500"
                        Margin="10"
                        HorizontalAlignment="Stretch"/>
                
                <ProgressBar Grid.Column="1"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding VehicleFuel}"
                             Height="20"
                             Margin="10"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Foreground="#FFB500"/>
            </Grid>
            
            <StackPanel Grid.Column="4" Orientation="Vertical">
                <ComboBox 
                          SelectedItem="{Binding VehicleStatus, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding CanChangeStatus}">
                    <ComboBox.Items>
                        <x:String>Available</x:String>
                        <x:String>In Route</x:String>
                        <x:String>Service</x:String>
                    </ComboBox.Items>
                </ComboBox>

                <TextBlock Text="{Binding VehicleStatus}" 
                           Foreground="{Binding StatusColor}" 
                           Margin="5,0,0,0"/>
            </StackPanel>

        </Grid>

    </Border>
</UserControl>
